#!/bin/bash
# Inspection firewall: a Linux router with the Day 4 stateful forward policy.
set -eux
dnf install -y nftables conntrack-tools

cat > /etc/sysctl.d/90-forward.conf <<'SYSCTL'
net.ipv4.ip_forward=1
SYSCTL
sysctl --system

cat > /etc/sysconfig/nftables.conf <<'NFT'
flush ruleset
table inet filter {
  chain forward {
    type filter hook forward priority 0; policy drop;
    ct state established,related accept
    ct state invalid counter drop
    ip saddr 10.0.0.0/8 ct state new accept
  }
}
NFT

systemctl enable --now nftables
