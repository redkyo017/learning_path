{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ScopedS3ReadWriteOwnBucketsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::cyberlab-day13-*",
        "arn:aws:s3:::cyberlab-day13-*/*"
      ]
    },
    {
      "Sid": "ScopedEC2ReadOnly",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*"
    }
  ]
}
