# "Temporary" config, added 2024, never removed. Real config should come
# from environment injection backed by a secrets manager -- see
# content/day10-secrets-supplychain.md Section 3 (Defense Lab).

stripe:
  # Fake key, shaped after the real sk_live_ prefix gitleaks' "stripe-access-
  # token" rule looks for; a few characters swapped for underscores so it
  # doesn't match GitHub's push-protection pattern byte-for-byte (it'll still
  # trip gitleaks' generic-api-key rule via the "api_key:" context keyword).
  api_key: "sk_live_51NfZTBHcgp_EXAMPLE_FAKE_KEY_DONOTUSE_00"

flask:
  # A Flask app SECRET_KEY hardcoded in version-controlled config instead of
  # generated per-environment and injected at deploy time.
  secret_key: "correct-horse-battery-staple-2024"

# Old creds, commented out, left behind instead of deleted -- gitleaks scans
# comments too, and this is a very common real-world way secrets leak: not
# the current config, but the *previous* one nobody scrubbed.
# legacy_db_password: "Winter2019!Fake"
