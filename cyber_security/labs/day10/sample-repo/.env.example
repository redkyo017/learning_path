# Local dev environment variables.
# NOTE (planted for Day 10): this is exactly the mistake the Concept section
# calls "secrets sprawl" -- these values belong in AWS Secrets Manager / SSM
# Parameter Store, not in a file sitting in the repo. AWS_ACCESS_KEY_ID/
# AWS_SECRET_ACCESS_KEY below are shaped after AWS's own published
# documentation example key pair (not real credentials), with a few
# characters swapped for underscores so they don't match GitHub's own
# push-protection/secret-scanning patterns byte-for-byte -- they're still
# fake-but-secret-shaped enough for gitleaks/trufflehog's keyword+entropy
# rules to flag them the way they'd flag a real leak.

AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_DEFAULT_REGION=us-east-1

DATABASE_URL=postgresql://svc_notifier:Tr0ub4dor&3Fake@db.internal.example:5432/orders

SLACK_WEBHOOK_URL=slack_url
