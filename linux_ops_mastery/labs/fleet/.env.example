# Copy to .env for local use:  cp .env.example .env
#
# Do not commit .env. It is not in the repository .gitignore yet -- add
# `linux_ops_mastery/labs/fleet/.env` to it before you create the file.
#
# This is a laboratory password for a database that listens only on the
# linuxops_net bridge and holds nothing. It is still a placeholder: change it
# locally, and never put a real credential in this tree.
POSTGRES_PASSWORD=changeme-locally
