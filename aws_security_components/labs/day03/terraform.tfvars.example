# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored —
# never commit real values (see repo .gitignore and ANTIPATTERNS.md #10).

region = "us-east-1" # must match labs/base's region

project = "aws-sec-lab" # must match labs/base's `project` value exactly

learner_principal_arn = "arn:aws:iam::REPLACE_ME_ACCOUNT_ID:user/REPLACE_ME_USER"
# ^ REPLACE with the ARN of the IAM user/role you already use to run the
#   AWS CLI in this account. Find it with: aws sts get-caller-identity

# Phase 1 (THE BREAK) — apply with this at its default, false, first.
# Phase 2 (THE HARDEN) — flip to true and re-apply. See README.md.
enable_key_policy_hardening = false

tags = {
  Day = "day03"
}
