# Copy to terraform.tfvars and edit. Real terraform.tfvars is gitignored;
# only this .example ships in the repo. No credentials belong in this file.

region = "us-east-1"      # must match the region labs/base was applied into
project = "aws-sec-lab"   # cosmetic prefix for this day's resource names only

min_severity              = 7   # GuardDuty Medium/High boundary
lambda_log_retention_days = 3

config_demo_bucket_force_destroy = true
