# Interpolation values for docker-compose.yml (${VAR:-default}). Compose reads `.env` from the
# directory of the first compose file (labs/day02/). `.env` is NOT passed into containers.
# A `.env` in the current directory (course root) is ALSO read and wins per variable: keep the root free of one.
# Copy to .env; `.env` must stay untracked. Local-only placeholder, never a real credential.
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=orderflow
