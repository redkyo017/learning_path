# dbmastery lab stack — MySQL 8.4 configuration.
# Mounted at /etc/mysql/conf.d/my.cnf (see docker-compose.yml).
# Local-only stack: password is `dbmastery`.

[mysqld]

# innodb_buffer_pool_size=256M is DELIBERATELY small relative to the
# ~24 GB the learner's host actually has, matching shared_buffers on the
# Postgres side. With the working set larger than the buffer pool, the
# InnoDB buffer pool hit ratio and physical read counts become visible
# and meaningful teaching signals instead of always reading 100% from
# memory. Do not raise this value.
innodb_buffer_pool_size = 256M

# MySQL 8.4 ships local_infile OFF server-side by default. The seed
# loader (labs/stack/seed/20-mysql-load.sh) uses LOAD DATA LOCAL INFILE to
# bulk-load the payments subset, which needs this ON on the server as
# well as `--local-infile=1` on the client -- without it, the first load
# fails with ERROR 3948. Cross-task edit: added for Task 2's seed loader,
# recorded in the task ledger.
local_infile = ON

# Exposes per-statement and per-wait instrumentation; labs query
# performance_schema tables directly to diagnose query cost and locking.
performance_schema = ON

# Enables the slow query log so long_query_time below actually captures
# anything.
slow_query_log = ON

# Logs any statement taking >= 0.5s — the same slow-query threshold used
# on the Postgres side, for a consistent baseline across engines.
long_query_time = 0.5

# Flushes and syncs the redo log to disk on every transaction commit —
# full ACID durability, the default and correct setting for a course that
# teaches durability trade-offs deliberately, rather than accidentally.
innodb_flush_log_at_trx_commit = 1

# Prints full deadlock details to the error log on every deadlock, not
# only the last one InnoDB happened to keep — required for the
# deadlock-diagnosis labs.
innodb_print_all_deadlocks = ON

# Enables binary logging (as file base name "binlog"), required for
# replication-style and point-in-time-recovery-style exercises on MySQL.
log_bin = binlog

# Row-based binlog format: logs the actual changed rows rather than the
# SQL statements that produced them, which is what the replication labs
# expect to inspect.
binlog_format = ROW
